TELEGRAM_BOT_TOKEN=

# Telegram local Bot API server (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Operational limits (defaults: 120 minutes, 300 MB, 5 waiting jobs)
# PSY_MAX_AUDIO_MINUTES=120
# PSY_MAX_AUDIO_MB=300
# PSY_MAX_QUEUE_LENGTH=5
# How long audio and results are kept; also shown in the consent text
# PSY_DATA_TTL_DAYS=30

# Who can call /stats (comma-separated chat ids); empty disables the command
# PSY_ADMIN_CHAT_IDS=123456789

# Donations: buttons are hidden unless configured
# PSY_DONATE_URL=https://pay.cloudtips.ru/p/xxxxxxxx
# PSY_DONATE_TON_ADDRESS=UQ...

# Optional processing overrides
# PSY_WHISPER_MODEL=~/.cache/mlx/large-v3-turbo
# PSY_DIARIZATION_MODEL=mlx-community/pyannote-segmentation-3.0-mlx
# PSY_MAX_SPEAKERS=2
